APP_NAME="Bambi Knowledge Agent"
APP_ENV=development
HOST=0.0.0.0
PORT=8000
ADMIN_API_TOKEN=change-me
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_MESSAGE_MAX_LENGTH=4000
CHAT_HISTORY_RETENTION_DAYS=7
STORAGE_BACKEND=sqlite
DYNAMODB_TABLE_NAME=
AWS_REGION=eu-central-1

DATA_DIR=./data
SQLITE_PATH=./data/bambi.db
SESSION_DB_PATH=./data/agent_sessions.db

LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
OPENAI_TEXT_VERBOSITY=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1600
ANTHROPIC_MAX_TOOL_ROUNDS=10
ANTHROPIC_TIMEOUT_SECONDS=90
ANTHROPIC_HISTORY_MESSAGES=20

MYBUSINESS_BASE_URL=https://api.mbapps.co.il/parse
MYBUSINESS_APP_ID=
MYBUSINESS_MASTER_KEY=
MYBUSINESS_TIMEOUT_SECONDS=20

INGEST_ON_STARTUP=false
